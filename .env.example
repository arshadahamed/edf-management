# Server / Security
PORT=3001
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret_min_32_characters

# Cloudflare Tunnel (used by start-edf.bat)
CLOUDFLARE_TUNNEL_NAME=edf
CLOUDFLARE_TUNNEL_ID=12dbcf8b-13bf-426d-b6bd-8ba7cb8c573c
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Remote Turso Database (leave blank locally to use src/db/database.sqlite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob Cloud Storage (leave blank locally to use disk public/uploads & backups)
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=public
