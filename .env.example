# Server / Security
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret_min_32_characters

# Remote Turso Database (leave blank locally to use src/db/database.sqlite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob Cloud Storage (leave blank locally to use disk public/uploads & backups)
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=public
